[Unit]
Description=Cosmos API Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cosmos_service
Environment=API_HOST=0.0.0.0
Environment=API_PORT=8080
Environment=AWS_DEFAULT_REGION=us-west-2
Environment=NUM_GPUS=8
Environment=NPROC_PER_NODE=8
ExecStart=/usr/bin/python3 /home/ubuntu/cosmos_service/cosmos_api_service_simple.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
