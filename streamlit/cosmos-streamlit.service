[Unit]
Description=Cosmos Streamlit Web UI
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cosmos_service/streamlit
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/miniconda3/bin:/usr/local/bin:/usr/bin:/bin
Environment=STREAMLIT_SERVER_PORT=5000
Environment=STREAMLIT_SERVER_ADDRESS=0.0.0.0
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ExecStart=/home/ubuntu/.local/bin/streamlit run streamlit_app.py --server.port=5000 --server.address=0.0.0.0 --browser.gatherUsageStats=false --server.headless=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
